[Unit]
Description=WOMAP durable job worker
Wants=network-online.target womap-api.service
After=network-online.target postgresql.service womap-api.service

[Service]
Type=simple
User=womap
Group=womap
WorkingDirectory=/opt/womap
Environment=WOMAP_RUNTIME_MODE=production
Environment=WOMAP_WORKER_ENABLED=true
Environment=UV_CACHE_DIR=/var/cache/womap/uv
ExecStart=/usr/bin/env uv run python -m app.features.jobs.worker
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
KillSignal=SIGTERM
Nice=10
CPUWeight=40
IOWeight=40
MemoryHigh=50%
TasksMax=512
LimitNOFILE=8192
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
